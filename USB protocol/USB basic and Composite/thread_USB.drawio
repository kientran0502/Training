n phẩm (ví dụ: &quot;USB CDC Device&quot;)&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;table&gt;&lt;tbody&gt;&lt;tr data-start=&quot;1189&quot; data-end=&quot;1256&quot;&gt;&lt;td class=&quot;&quot; data-start=&quot;1189&quot; data-end=&quot;1226&quot;&gt;&lt;code data-start=&quot;1191&quot; data-end=&quot;1220&quot;&gt;USBD_FS_SerialStrDescriptor&lt;/code&gt;&lt;/td&gt;&lt;td class=&quot;&quot; data-start=&quot;1226&quot; data-end=&quot;1256&quot;&gt;Serial Number của thiết bị&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;table&gt;&lt;tbody&gt;&lt;tr data-start=&quot;1257&quot; data-end=&quot;1352&quot;&gt;&lt;td class=&quot;&quot; data-start=&quot;1257&quot; data-end=&quot;1294&quot;&gt;&lt;code data-start=&quot;1259&quot; data-end=&quot;1288&quot;&gt;USBD_FS_ConfigStrDescriptor&lt;/code&gt;&lt;/td&gt;&lt;td class=&quot;min-w-[calc(var(--thread-content-max-width)/3)]&quot; data-start=&quot;1294&quot; data-end=&quot;1352&quot;&gt;Chuỗi mô tả cấu hình (Configuration Descriptor String)&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;table&gt;&lt;tbody&gt;&lt;tr data-start=&quot;1353&quot; data-end=&quot;1445&quot;&gt;&lt;td class=&quot;&quot; data-start=&quot;1353&quot; data-end=&quot;1390&quot;&gt;&lt;code data-start=&quot;1355&quot; data-end=&quot;1387&quot;&gt;USBD_FS_InterfaceStrDescriptor&lt;/code&gt;&lt;/td&gt;&lt;td class=&quot;min-w-[calc(var(--thread-content-max-width)/3)]&quot; data-start=&quot;1390&quot; data-end=&quot;1445&quot;&gt;Chuỗi mô tả interface (Interface Descriptor String)&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" style="text;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
