        <mxCell id="owDj22nM5t_Lmnq3w9KW-10" value="&lt;div&gt;- Chọn tốc độ thiết bị (Full/High Speed),&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;Cấu hình khung thời gian (frame interval),&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;Thiết lập địa chỉ thiết bị&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- Soft disconnect,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Ngắt điều khiển thiết bị,&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Power-on reset.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-align: center;&quot;&gt;Trạng thái kết nối,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-align: center;&quot;&gt;Trạng thái suspend/resume,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-align: center;&quot;&gt;Tốc độ USB hiện tại (Low/Full/High Speed).&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="1025.6" y="2640" width="580" height="60" as="geometry" />
        </mxCell>
        <mxCell id="owDj22nM5t_Lmnq3w9KW-11" value="- Thiết lập mặt nạ ngắt cho tất cả endpoint IN (thiết bị → host) (Mask các ngắt như: TXFIFO empty, transfer complete,...)&lt;div&gt;-&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Tương tự &lt;/span&gt;&lt;code style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot; data-end=&quot;1107&quot; data-start=&quot;1098&quot;&gt;DIEPMSK&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;, nhưng cho các endpoint OUT (&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Mask các ngắt nhận dữ liệu, truyền hoàn tất,...)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Cờ báo ngắt cho tất cả các endpoint IN và OUT,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Bit thấp: OUT EP, Bit cao: IN EP.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;- Cho phép/bỏ qua ngắt từ các endpoint riêng biệt.&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="1025.6" y="2695" width="660" height="70" as="geometry" />
        </mxCell>
        <mxCell id="owDj22nM5t_Lmnq3w9KW-12" value="- Thiết lập thời gian xả VBUS khi ngắt kết nối,&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Giúp tắt nhanh điện áp VBUS&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Cấu hình độ rộng xung VBUS để khởi tạo reset bus&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Kiểm soát ngưỡng kích hoạt truyền/nhận dữ liệu,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Cho phép bật chế độ truyền tức thời (ISO IN/OUT) hoặc delay đến ngưỡng FIFO.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;-&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Cho phép ngắt khi FIFO endpoint IN trống.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;- Dùng cho chế độ endpoint riêng biệt (như Audio/MIDI).&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="1040" y="2773" width="730" height="90" as="geometry" />
        </mxCell>
        <mxCell id="owDj22nM5t_Lmnq3w9KW-13" value="- Ngắt riêng cho endpoint OUT số 1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="1031" y="2893" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="owDj22nM5t_Lmnq3w9KW-14" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;các thanh ghi điều khiển thiết bị USB (Device Mode) trong STM32 USB OTG&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="620" y="2630" width="450" height="30" as="geometry" />
        </mxCell>
        <mxCell id="owDj22nM5t_Lmnq3w9KW-15" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;thanh ghi khối USB OTG(On-The-Go) trong STM32 — áp dụng cho cả chế độ Host và Device&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="-125" y="1400" width="550" height="30" as="geometry" />
        </mxCell>
        <mxCell id="owDj22nM5t_Lmnq3w9KW-16" value="- Điều khiển và theo dõi trạng thái OTG,&amp;nbsp;chuyển vai trò Host/Device, trạng thái ID pin.&lt;div&gt;-&amp;nbsp;Cờ ngắt liên quan đến các sự kiện OTG,&amp;nbsp;Chuyển đổi vai trò (Host ↔ Device).Ngắt nhận ID pin.&lt;/div&gt;&lt;div&gt;-&amp;nbsp;Cấu hình liên quan đến bus AHB, ngắt toàn cục, DMA&lt;/div&gt;&lt;div&gt;- Tốc độ hoạt động,&amp;nbsp;Thời gian turnaround,&amp;nbsp;Kiểu&amp;nbsp; kết nối vật lí PHY (embedded/full speed).&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
