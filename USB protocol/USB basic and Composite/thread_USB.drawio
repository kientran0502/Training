        <mxCell id="-AxNQQQo55_-glkVazCq-2" value="&lt;font style=&quot;font-size: 14px; color: rgb(255, 0, 0);&quot;&gt;94&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="1040" y="5070" width="40" height="30" as="geometry" />
        </mxCell>
        <mxCell id="gMQvPt-shMmsNhGTyDlI-0" value="&lt;span style=&quot;color: rgba(0, 0, 0, 0.85); font-family: Ubuntu, sans-serif; font-size: medium; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: justify; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;Hàm này khởi tạo các thiết bị ngoại vi USB của bộ vi điều khiển. Điều thú vị nhất là chuỗi các lệnh gọi đến hàm HAL_PCDEx_PMAConfig(). Thực tế là trên bo mạch của bộ vi điều khiển có toàn bộ 512 byte bộ nhớ được phân bổ riêng cho bộ đệm USB (bộ nhớ này được gọi là PMA - Packet Memory Area).&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
