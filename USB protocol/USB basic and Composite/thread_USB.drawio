        <mxCell id="6O0yb1bMCelvoenXBvAB-0" value="&lt;b&gt;&lt;font style=&quot;font-size: 17px; color: rgb(255, 51, 51);&quot;&gt;Mở define cho define USB COMPOSITE&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
