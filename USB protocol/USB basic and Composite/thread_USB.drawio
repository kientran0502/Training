        <mxCell id="rK4b5C6XHwDH_ajIK823-7" value="Sau 1 hồi mò mẫm thì nó được định nghĩa và truyền đi từ file usbd.c" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
